"""
Module 08 – OptiLoop
AI Optimization Assistant: compares Target vs Expected vs TCAD simulation
results and recommends parameter modifications to bring the device
toward specification.

Compares:
  - Leakage (Ioff)
  - On-current (Ion)
  - Threshold voltage (Vth)
  - Power consumption

Returns Accept / Modify / Reject + recommended parameter modifications.
"""

from __future__ import annotations
from dataclasses import dataclass, field
from enum import Enum
from typing import Optional

from .smart_sample import DeviceCharacteristics
from .simu_vision import SimulationAnalysis
from .device_architect import DeviceDesign


class Verdict(str, Enum):
    ACCEPT = "ACCEPT"
    MODIFY = "MODIFY"
    REJECT = "REJECT"


@dataclass
class TargetSpec:
    """Engineer-defined performance targets."""
    max_ioff_A_um: Optional[float] = None       # A/µm
    min_ion_A_um: Optional[float] = None        # A/µm
    vth_V: Optional[float] = None               # V (nominal)
    vth_tolerance_V: float = 0.05               # ±V
    max_power_static_uW: Optional[float] = None # µW
    min_ion_ioff_ratio: Optional[float] = None
    max_ss_mV_dec: Optional[float] = 100.0

    def to_dict(self) -> dict:
        return {k: v for k, v in self.__dict__.items() if v is not None}


@dataclass
class Modification:
    parameter: str
    current_value: float
    suggested_value: float
    unit: str
    reason: str

    def to_dict(self) -> dict:
        direction = "↑" if self.suggested_value > self.current_value else "↓"
        return {
            "parameter": self.parameter,
            "current": f"{self.current_value} {self.unit}",
            "suggested": f"{self.suggested_value} {self.unit} {direction}",
            "reason": self.reason,
        }


@dataclass
class OptimizationResult:
    verdict: Verdict = Verdict.ACCEPT
    score: float = 1.0                   # 0–1, how well spec is met
    violations: list[str] = field(default_factory=list)
    modifications: list[Modification] = field(default_factory=list)
    summary: str = ""

    def to_dict(self) -> dict:
        return {
            "verdict": self.verdict.value,
            "score": round(self.score, 3),
            "violations": self.violations,
            "modifications": [m.to_dict() for m in self.modifications],
            "summary": self.summary,
        }


class OptiLoop:
    """
    Rule-based optimization engine that iteratively suggests single-
    parameter modifications to resolve specification violations.
    """

    _MAX_ITERATIONS = 5

    def optimize(
        self,
        design: DeviceDesign,
        analysis: SimulationAnalysis,
        spec: TargetSpec,
        expected: Optional[DeviceCharacteristics] = None,
    ) -> OptimizationResult:
        result = OptimizationResult()
        penalties: list[float] = []

        # ------------------------------------------------------------------ #
        # 1. Check each spec metric                                           #
        # ------------------------------------------------------------------ #

        # --- Leakage (Ioff) ---
        if spec.max_ioff_A_um and analysis.ioff_A_um:
            if analysis.ioff_A_um > spec.max_ioff_A_um:
                excess_factor = analysis.ioff_A_um / spec.max_ioff_A_um
                result.violations.append(
                    f"Leakage too high: {analysis.ioff_A_um:.2e} A/µm "
                    f"(limit {spec.max_ioff_A_um:.2e}, ×{excess_factor:.1f})"
                )
                penalties.append(min(excess_factor - 1, 1.0))

                # Suggest: increase Vth via doping or longer channel
                new_L = min(design.channel_length_nm * 1.1, 500.0)
                result.modifications.append(Modification(
                    parameter="channel_length_nm",
                    current_value=design.channel_length_nm,
                    suggested_value=round(new_L, 1),
                    unit="nm",
                    reason="Longer channel reduces DIBL and subthreshold leakage.",
                ))
                new_doping = design.doping_channel_cm3 * 1.2
                result.modifications.append(Modification(
                    parameter="doping_channel_cm3",
                    current_value=design.doping_channel_cm3,
                    suggested_value=round(new_doping, 2),
                    unit="cm⁻³",
                    reason="Higher channel doping raises Vth, suppressing Ioff.",
                ))

        # --- On-current (Ion) ---
        if spec.min_ion_A_um and analysis.ion_A_um:
            if analysis.ion_A_um < spec.min_ion_A_um:
                deficit_factor = spec.min_ion_A_um / analysis.ion_A_um
                result.violations.append(
                    f"Ion too low: {analysis.ion_A_um:.2e} A/µm "
                    f"(need ≥ {spec.min_ion_A_um:.2e}, ×{deficit_factor:.1f} short)"
                )
                penalties.append(min(deficit_factor - 1, 1.0))

                # Suggest: wider device, shorter channel, thinner oxide
                new_W = design.channel_width_nm * deficit_factor ** 0.5
                result.modifications.append(Modification(
                    parameter="channel_width_nm",
                    current_value=design.channel_width_nm,
                    suggested_value=round(new_W, 1),
                    unit="nm",
                    reason="Wider channel increases Ion proportionally.",
                ))
                new_tox = max(0.8, design.oxide_thickness_nm * 0.9)
                result.modifications.append(Modification(
                    parameter="oxide_thickness_nm",
                    current_value=design.oxide_thickness_nm,
                    suggested_value=round(new_tox, 2),
                    unit="nm",
                    reason="Thinner oxide boosts Cox and gate drive.",
                ))

        # --- Threshold voltage (Vth) ---
        if spec.vth_V is not None and analysis.vth_V is not None:
            drift = analysis.vth_V - spec.vth_V
            if abs(drift) > spec.vth_tolerance_V:
                result.violations.append(
                    f"Vth slightly high: {analysis.vth_V:.3f} V "
                    f"(target {spec.vth_V:.3f} V, Δ={drift:+.3f} V)"
                    if drift > 0
                    else f"Vth slightly low: {analysis.vth_V:.3f} V "
                    f"(target {spec.vth_V:.3f} V, Δ={drift:+.3f} V)"
                )
                penalties.append(abs(drift) / spec.vth_tolerance_V * 0.3)

                # Suggest: adjust channel doping
                doping_delta = 1.1 if drift < 0 else 0.9
                new_doping = design.doping_channel_cm3 * doping_delta
                result.modifications.append(Modification(
                    parameter="doping_channel_cm3",
                    current_value=design.doping_channel_cm3,
                    suggested_value=round(new_doping, 2),
                    unit="cm⁻³",
                    reason=(
                        "Adjust channel doping to tune Vth toward target. "
                        f"{'Increase' if drift < 0 else 'Decrease'} doping "
                        f"to {'raise' if drift < 0 else 'lower'} Vth."
                    ),
                ))

        # --- Subthreshold slope ---
        if spec.max_ss_mV_dec and analysis.ss_mV_dec:
            if analysis.ss_mV_dec > spec.max_ss_mV_dec:
                result.violations.append(
                    f"SS = {analysis.ss_mV_dec:.1f} mV/dec "
                    f"(limit {spec.max_ss_mV_dec:.0f} mV/dec)"
                )
                penalties.append(
                    (analysis.ss_mV_dec - spec.max_ss_mV_dec) / spec.max_ss_mV_dec
                )
                new_L = min(design.channel_length_nm * 1.15, 500.0)
                result.modifications.append(Modification(
                    parameter="channel_length_nm",
                    current_value=design.channel_length_nm,
                    suggested_value=round(new_L, 1),
                    unit="nm",
                    reason=(
                        "Longer channel reduces short-channel effects "
                        "and improves subthreshold slope."
                    ),
                ))

        # --- Power ---
        if spec.max_power_static_uW and analysis.power_static_uW:
            if analysis.power_static_uW > spec.max_power_static_uW:
                result.violations.append(
                    f"Static power too high: {analysis.power_static_uW:.4f} µW "
                    f"(limit {spec.max_power_static_uW:.4f} µW)"
                )
                penalties.append(
                    analysis.power_static_uW / spec.max_power_static_uW - 1
                )

        # ------------------------------------------------------------------ #
        # 2. Compute overall score and verdict                                #
        # ------------------------------------------------------------------ #
        if penalties:
            result.score = max(0.0, 1.0 - sum(penalties) / len(penalties))
        else:
            result.score = 1.0

        if not result.violations:
            result.verdict = Verdict.ACCEPT
            result.summary = "All specification targets met. Design is accepted."
        elif result.score >= 0.6:
            result.verdict = Verdict.MODIFY
            result.summary = (
                "Device is close to target but requires parameter adjustment. "
                "Apply suggested modifications and re-simulate."
            )
        else:
            result.verdict = Verdict.REJECT
            result.summary = (
                "Significant specification violations detected. "
                "Major design revision required before re-simulation."
            )

        return result


