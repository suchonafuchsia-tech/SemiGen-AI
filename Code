"""
Module 09 – Engineer-in-the-Loop
Validation & Decision: presents all AI-generated predictions, analyses,
and recommendations to the engineer and collects a final decision
(Accept / Modify / Reject) with optional override parameters.

SemiGen AI provides:
  Prediction + Analysis + Physical Explanation + Optimization Recommendation

Engineer provides:
  Validation + Engineering Judgment + Final Decision

SemiGen AI assists — it does NOT replace the engineer.
"""

from __future__ import annotations
from dataclasses import dataclass, field
from datetime import datetime
from enum import Enum
from typing import Optional

from .intent2device import DeviceRequirements
from .device_architect import DeviceDesign
from .smart_sample import DeviceCharacteristics
from .simu_vision import SimulationAnalysis
from .error_radar import ErrorReport
from .opti_loop import OptimizationResult, Verdict, TargetSpec


class EngineerDecision(str, Enum):
    ACCEPT = "ACCEPT"
    MODIFY = "MODIFY"
    REJECT = "REJECT"


@dataclass
class DesignSession:
    """Holds the full state of one design iteration."""
    session_id: str
    timestamp: str
    requirements: Optional[DeviceRequirements] = None
    design: Optional[DeviceDesign] = None
    characteristics: Optional[DeviceCharacteristics] = None
    analysis: Optional[SimulationAnalysis] = None
    error_report: Optional[ErrorReport] = None
    optimization: Optional[OptimizationResult] = None
    engineer_decision: Optional[EngineerDecision] = None
    engineer_notes: str = ""
    manual_overrides: dict = field(default_factory=dict)
    iteration: int = 1

    def to_dict(self) -> dict:
        return {
            "session_id": self.session_id,
            "timestamp": self.timestamp,
            "iteration": self.iteration,
            "requirements": self.requirements.to_dict() if self.requirements else None,
            "design": self.design.to_dict() if self.design else None,
            "ai_recommendation": (
                self.optimization.verdict.value if self.optimization else "N/A"
            ),
            "engineer_decision": (
                self.engineer_decision.value if self.engineer_decision else "PENDING"
            ),
            "engineer_notes": self.engineer_notes,
            "manual_overrides": self.manual_overrides,
            "anomaly_count": (
                len(self.error_report.anomalies) if self.error_report else 0
            ),
        }


class EngineerInTheLoop:
    """
    Orchestrates the engineer review step.

    Presents a concise briefing of all AI findings, then accepts
    the engineer's decision and any manual parameter overrides.
    The updated design is returned for the next iteration.
    """

    def generate_briefing(self, session: DesignSession) -> str:
        lines = [
            "=" * 70,
            f"  SEMIGEN AI — ENGINEER REVIEW BRIEFING",
            f"  Session: {session.session_id}  |  Iteration: {session.iteration}",
            f"  {session.timestamp}",
            "=" * 70,
        ]

        # Requirements
        if session.requirements:
            r = session.requirements
            lines += [
                "",
                "[ REQUIREMENTS ]",
                f"  Device       : {r.device_type} ({r.channel_type}-channel)",
                f"  Power class  : {r.power_class}",
                f"  Drive current: {r.drive_current}",
                f"  Leakage      : {r.leakage_target}",
                f"  Application  : {r.application or 'unspecified'}",
            ]

        # Design parameters
        if session.design:
            d = session.design
            lines += [
                "",
                "[ PROPOSED DESIGN ]",
                f"  Architecture       : {d.architecture}",
                f"  Channel length     : {d.channel_length_nm} nm",
                f"  Channel width      : {d.channel_width_nm} nm",
                f"  Oxide thickness    : {d.oxide_thickness_nm} nm ({d.oxide_material})",
                f"  Channel doping     : {d.doping_channel_cm3:.2e} cm⁻³",
                f"  Supply voltage     : {d.supply_voltage_V} V",
                f"  Vth target         : {d.vth_target_V} V",
            ]

        # Simulation analysis
        if session.analysis:
            a = session.analysis
            lines += [
                "",
                "[ SIMULATION ANALYSIS ]",
                f"  Vth extracted : {a.vth_V:.3f} V" if a.vth_V else "  Vth: N/A",
                f"  Ion           : {a.ion_A_um:.3e} A/µm" if a.ion_A_um else "  Ion: N/A",
                f"  Ioff          : {a.ioff_A_um:.3e} A/µm" if a.ioff_A_um else "  Ioff: N/A",
                f"  Ion/Ioff      : {a.ion_ioff_ratio:.2e}" if a.ion_ioff_ratio else "  Ion/Ioff: N/A",
                f"  SS            : {a.ss_mV_dec:.1f} mV/dec" if a.ss_mV_dec else "  SS: N/A",
                f"  Static power  : {a.power_static_uW:.4f} µW" if a.power_static_uW else "",
            ]
            for interp in a.interpretation:
                lines.append(f"  ↳ {interp}")
            for warn in a.warnings:
                lines.append(f"  ⚠ {warn}")

        # Error report
        if session.error_report:
            er = session.error_report
            if er.is_clean:
                lines += ["", "[ ERROR RADAR ] ✓ No anomalies detected."]
            else:
                lines += ["", f"[ ERROR RADAR ] {len(er.anomalies)} anomaly(ies) detected:"]
                for anomaly in er.anomalies:
                    lines.append(
                        f"  [{anomaly.severity.upper()}] {anomaly.location}: "
                        f"{anomaly.what_changed}"
                    )
                    lines.append(f"    Cause  : {anomaly.possible_cause}")
                    lines.append(f"    Effect : {anomaly.expected_physical_effect}")

        # Optimization recommendation
        if session.optimization:
            opt = session.optimization
            lines += [
                "",
                f"[ OPTLOOP RECOMMENDATION ] → {opt.verdict.value}",
                f"  Score  : {opt.score:.2f}",
                f"  Summary: {opt.summary}",
            ]
            if opt.modifications:
                lines.append("  Suggested modifications:")
                for mod in opt.modifications:
                    lines.append(
                        f"    • {mod.parameter}: {mod.current_value} → "
                        f"{mod.suggested_value} {mod.unit}  ({mod.reason})"
                    )

        lines += [
            "",
            "=" * 70,
            "  AI RECOMMENDATION: "
            + (session.optimization.verdict.value if session.optimization else "N/A"),
            "  Awaiting engineer decision: ACCEPT | MODIFY | REJECT",
            "=" * 70,
        ]
        return "\n".join(lines)

    def record_decision(
        self,
        session: DesignSession,
        decision: EngineerDecision,
        notes: str = "",
        overrides: Optional[dict] = None,
    ) -> DesignSession:
        """
        Record the engineer's final decision.
        If MODIFY, optionally apply manual overrides to the design.
        Returns an updated session (ready for next iteration if MODIFY).
        """
        session.engineer_decision = decision
        session.engineer_notes = notes
        if overrides:
            session.manual_overrides = overrides
            if session.design:
                for param, value in overrides.items():
                    if hasattr(session.design, param):
                        setattr(session.design, param, value)
                        session.design.notes.append(
                            f"[Iteration {session.iteration}] Engineer override: "
                            f"{param} = {value}"
                        )

        if decision == EngineerDecision.MODIFY:
            session.iteration += 1
            # Reset analysis fields for re-simulation
            session.analysis = None
            session.error_report = None
            session.optimization = None

        return session


# ---------------------------------------------------------------------------
# Session factory helper
# ---------------------------------------------------------------------------
def new_session(session_id: Optional[str] = None) -> DesignSession:
    import uuid
    return DesignSession(
        session_id=session_id or str(uuid.uuid4())[:8],
        timestamp=datetime.now().isoformat(timespec="seconds"),
    )


