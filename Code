#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
SemiGen AI — Main integration entry point.

Runs a complete design-evaluation-optimization cycle for a device
described in natural language, then presents the engineer briefing.

Usage:
    python main.py
    python main.py --desc "low-power PMOS for IoT" --max-ioff 1e-11

"""

from __future__ import annotations
import argparse
import io
import json
import sys

# Ensure UTF-8 output on Windows consoles
if sys.stdout.encoding and sys.stdout.encoding.lower() != "utf-8":
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
    sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding="utf-8", errors="replace")

from semigen_ai import (
    Intent2Device,
    DeviceArchitect,
    SmartSample,
    SiliconSense,
    SimuVision,
    ErrorRadar,
    OptiLoop, TargetSpec,
    EngineerInTheLoop, EngineerDecision,
    new_session,
)


def run_pipeline(
    description: str,
    target_spec: TargetSpec,
    auto_decision: str = "MODIFY",
    print_briefing: bool = True,
) -> dict:
    """
    Execute the full SemiGen AI pipeline for one design iteration.

    Returns a summary dict with all key results.
    """

    # ── Module 01: Intent2Device ──────────────────────────────────────────
    print("\n[M01] Intent2Device — parsing requirements…")
    requirements = Intent2Device().parse(description)
    print(f"  → Device: {requirements.device_type} ({requirements.channel_type})")
    print(f"  → Power: {requirements.power_class}  |  Leakage: {requirements.leakage_target}")

    # ── Module 02: Device Architect ───────────────────────────────────────
    print("\n[M02] Device Architect — proposing design…")
    design = DeviceArchitect().propose(requirements)
    print(f"  → Architecture  : {design.architecture}")
    print(f"  → Channel length: {design.channel_length_nm} nm")
    print(f"  → Oxide (tox)   : {design.oxide_thickness_nm} nm ({design.oxide_material})")
    print(f"  → Vth target    : {design.vth_target_V} V")

    # ── Module 04: SmartSample ────────────────────────────────────────────
    print("\n[M04] SmartSample — generating expected I-V characteristics…")
    char = SmartSample().generate(design)
    print(f"  → Ion  : {char.ion_A_um:.3e} A/µm")
    print(f"  → Ioff : {char.ioff_A_um:.3e} A/µm")
    print(f"  → Ion/Ioff ratio: {char.ion_ioff_ratio:.2e}")
    print(f"  → Transfer curve points: {len(char.iv_transfer)}")

    # ── Module 05: SiliconSense (oxide thickness demo) ────────────────────
    print("\n[M05] SiliconSense — parameter sensitivity analysis (tox)…")
    ss = SiliconSense()
    insight = ss.analyze(design, "oxide_thickness_nm", design.oxide_thickness_nm * 0.75)
    print(f"  → tox {insight.original_value:.1f}→{insight.new_value:.1f} nm: "
          f"ΔIon={insight.delta_ion_pct:+.1f}%  "
          f"ΔIoff={insight.delta_ioff_pct:+.1f}%")
    for eff in insight.qualitative_effects[:2]:
        print(f"     • {eff}")

    # ── Module 06: SimuVision ─────────────────────────────────────────────
    print("\n[M06] SimuVision — analyzing simulation results…")
    sv = SimuVision()
    analysis = sv.analyze_transfer(char.iv_transfer, vdd=abs(design.supply_voltage_V))
    output_obs = sv.analyze_output(char.iv_output)
    print(f"  → Vth extracted: {analysis.vth_V:.3f} V" if analysis.vth_V else "  → Vth: N/A")
    print(f"  → SS           : {analysis.ss_mV_dec:.1f} mV/dec" if analysis.ss_mV_dec else "")
    for obs in output_obs[:2]:
        print(f"  → Output: {obs}")

    # ── Module 07: ErrorRadar ─────────────────────────────────────────────
    print("\n[M07] ErrorRadar — checking for anomalies…")
    radar = ErrorRadar()
    error_report = radar.check(analysis, expected=char, vth_target=design.vth_target_V)
    param_report = radar.check_parameter_consistency(
        channel_length_nm=design.channel_length_nm,
        oxide_thickness_nm=design.oxide_thickness_nm,
        doping_channel_cm3=design.doping_channel_cm3,
        supply_voltage_V=design.supply_voltage_V,
        vth_target_V=design.vth_target_V,
    )
    all_anomalies = error_report.anomalies + param_report.anomalies
    if not all_anomalies:
        print("  → ✓ No anomalies detected.")
    else:
        for a in all_anomalies:
            print(f"  → [{a.severity.upper()}] {a.location}: {a.what_changed}")

    # ── Module 08: OptiLoop ───────────────────────────────────────────────
    print("\n[M08] OptiLoop — comparing target vs expected vs simulated…")
    opt = OptiLoop().optimize(design, analysis, target_spec, expected=char)
    print(f"  → Verdict: {opt.verdict.value}  (score: {opt.score:.2f})")
    print(f"  → {opt.summary}")
    for mod in opt.modifications[:3]:
        print(f"     • {mod.parameter}: {mod.current_value} → {mod.suggested_value} {mod.unit}")

    # ── Assemble session ──────────────────────────────────────────────────
    session = new_session()
    session.requirements = requirements
    session.design = design
    session.characteristics = char
    session.analysis = analysis
    session.error_report = error_report
    session.optimization = opt

    # ── Module 09: Engineer-in-the-Loop ───────────────────────────────────
    print("\n[M09] Engineer-in-the-Loop — generating briefing…\n")
    eitl = EngineerInTheLoop()
    if print_briefing:
        print(eitl.generate_briefing(session))

    # Record the decision (in non-interactive mode, use the auto_decision arg)
    decision = EngineerDecision(auto_decision.upper())
    session = eitl.record_decision(
        session,
        decision=decision,
        notes=f"[Auto] Decision set to {decision.value} for pipeline run.",
    )
    print(f"\n→ Engineer decision recorded: {session.engineer_decision.value}")

    return session.to_dict()


# ---------------------------------------------------------------------------
# CLI entry point
# ---------------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(description="SemiGen AI Prototype Pipeline")
    parser.add_argument(
        "--desc",
        default="I need a low-power NMOS with high drive current and low leakage.",
        help="Natural language device description",
    )
    parser.add_argument("--max-ioff", type=float, default=1e-10,
                        help="Max Ioff target (A/µm)")
    parser.add_argument("--min-ion", type=float, default=1e-5,
                        help="Min Ion target (A/µm)")
    parser.add_argument("--max-ss", type=float, default=90.0,
                        help="Max subthreshold slope (mV/dec)")
    parser.add_argument("--decision", default="MODIFY",
                        choices=["ACCEPT", "MODIFY", "REJECT"],
                        help="Simulated engineer decision (non-interactive)")
    parser.add_argument("--json", action="store_true",
                        help="Output final session as JSON")
    args = parser.parse_args()

    spec = TargetSpec(
        max_ioff_A_um=args.max_ioff,
        min_ion_A_um=args.min_ion,
        max_ss_mV_dec=args.max_ss,
    )

    print("=" * 70)
    print("  SEMIGEN AI — Functional Prototype")
    print("  An AI-Powered Semiconductor Design Assistant")
    print("=" * 70)

    result = run_pipeline(
        description=args.desc,
        target_spec=spec,
        auto_decision=args.decision,
        print_briefing=True,
    )

    if args.json:
        print("\n--- Session Summary (JSON) ---")
        print(json.dumps(result, indent=2, default=str))


if __name__ == "__main__":
    main()


