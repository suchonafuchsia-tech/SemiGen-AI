"""
Module 05 – SiliconSense
Parameter-to-Physics Intelligence: explains how changing a physical
parameter (e.g. oxide thickness) affects device parameters and
electrical behaviour.
"""

from __future__ import annotations
from dataclasses import dataclass, field
from typing import Callable

from .device_architect import DeviceDesign
from .smart_sample import SmartSample, DeviceCharacteristics


@dataclass
class PhysicsInsight:
    parameter: str
    original_value: float
    new_value: float
    unit: str
    delta_vth_V: float = 0.0
    delta_ion_pct: float = 0.0
    delta_ioff_pct: float = 0.0
    delta_ss_mV_dec: float = 0.0
    qualitative_effects: list[str] = field(default_factory=list)

    def to_dict(self) -> dict:
        return {
            "parameter": self.parameter,
            "change": f"{self.original_value} → {self.new_value} {self.unit}",
            "delta_vth_V": round(self.delta_vth_V, 4),
            "delta_ion_pct": round(self.delta_ion_pct, 2),
            "delta_ioff_pct": round(self.delta_ioff_pct, 2),
            "delta_ss_mV_dec": round(self.delta_ss_mV_dec, 2),
            "qualitative_effects": self.qualitative_effects,
        }


# Map of parameter name → (getter, setter, unit)
_PARAM_ACCESSORS: dict[
    str, tuple[Callable[[DeviceDesign], float], Callable[[DeviceDesign, float], None], str]
] = {
    "oxide_thickness_nm": (
        lambda d: d.oxide_thickness_nm,
        lambda d, v: setattr(d, "oxide_thickness_nm", v),
        "nm",
    ),
    "channel_length_nm": (
        lambda d: d.channel_length_nm,
        lambda d, v: setattr(d, "channel_length_nm", v),
        "nm",
    ),
    "channel_width_nm": (
        lambda d: d.channel_width_nm,
        lambda d, v: setattr(d, "channel_width_nm", v),
        "nm",
    ),
    "doping_channel_cm3": (
        lambda d: d.doping_channel_cm3,
        lambda d, v: setattr(d, "doping_channel_cm3", v),
        "cm⁻³",
    ),
    "supply_voltage_V": (
        lambda d: d.supply_voltage_V,
        lambda d, v: setattr(d, "supply_voltage_V", v),
        "V",
    ),
    "vth_target_V": (
        lambda d: d.vth_target_V,
        lambda d, v: setattr(d, "vth_target_V", v),
        "V",
    ),
}


def _clone_design(design: DeviceDesign) -> DeviceDesign:
    """Shallow-copy a DeviceDesign."""
    import copy
    return copy.copy(design)


class SiliconSense:
    """
    Performs a two-point parameter sweep to quantify how a single
    physical parameter change propagates to device electrical metrics.
    """

    _sampler = SmartSample()

    # --- qualitative knowledge base ----------------------------------------
    _QUALITATIVE: dict[str, dict[str, list[str]]] = {
        "oxide_thickness_nm": {
            "decrease": [
                "Stronger gate control (higher Cox → higher Ion).",
                "Vth may decrease slightly.",
                "Gate leakage risk increases due to direct tunnelling.",
                "Gate capacitance increases.",
            ],
            "increase": [
                "Weaker gate control (lower Cox → lower Ion).",
                "Vth may increase slightly.",
                "Gate leakage risk decreases.",
                "Gate capacitance decreases.",
            ],
        },
        "channel_length_nm": {
            "decrease": [
                "Short-channel effects (SCE) worsen — DIBL, Vth roll-off.",
                "Ion increases due to higher electric field.",
                "Ioff increases significantly.",
                "Subthreshold slope degrades.",
            ],
            "increase": [
                "Better SCE control — improved Vth stability.",
                "Ion decreases (longer drift path).",
                "Ioff decreases — better off-state leakage.",
                "Subthreshold slope improves toward 60 mV/dec.",
            ],
        },
        "doping_channel_cm3": {
            "increase": [
                "Higher Vth (body effect).",
                "Reduced depletion width — better SCE control.",
                "Mobility degradation due to impurity scattering.",
                "Ioff decreases.",
            ],
            "decrease": [
                "Lower Vth.",
                "Wider depletion region.",
                "Improved channel mobility.",
                "Ioff may increase.",
            ],
        },
        "channel_width_nm": {
            "increase": [
                "Ion increases linearly with width.",
                "Ioff increases proportionally.",
                "Power consumption increases.",
            ],
            "decrease": [
                "Ion decreases.",
                "Lower power consumption.",
                "Narrow-width effect may shift Vth.",
            ],
        },
    }

    def analyze(
        self,
        design: DeviceDesign,
        parameter: str,
        new_value: float,
    ) -> PhysicsInsight:
        if parameter not in _PARAM_ACCESSORS:
            raise ValueError(
                f"Unknown parameter '{parameter}'. "
                f"Supported: {list(_PARAM_ACCESSORS)}"
            )

        getter, setter, unit = _PARAM_ACCESSORS[parameter]
        original_value = getter(design)

        # --- simulate original ---
        char_orig: DeviceCharacteristics = self._sampler.generate(design)

        # --- simulate modified ---
        modified = _clone_design(design)
        setter(modified, new_value)
        char_mod: DeviceCharacteristics = self._sampler.generate(modified)

        def _pct(orig, new):
            if orig == 0:
                return 0.0
            return (new - orig) / abs(orig) * 100

        direction = "increase" if new_value > original_value else "decrease"
        qual = self._QUALITATIVE.get(parameter, {}).get(direction, [])

        return PhysicsInsight(
            parameter=parameter,
            original_value=original_value,
            new_value=new_value,
            unit=unit,
            delta_vth_V=char_mod.vth_V - char_orig.vth_V,
            delta_ion_pct=_pct(char_orig.ion_A_um, char_mod.ion_A_um),
            delta_ioff_pct=_pct(char_orig.ioff_A_um, char_mod.ioff_A_um),
            delta_ss_mV_dec=char_mod.ss_mV_dec - char_orig.ss_mV_dec,
            qualitative_effects=qual,
        )

    def compare_parameter_sweep(
        self,
        design: DeviceDesign,
        parameter: str,
        values: list[float],
    ) -> list[PhysicsInsight]:
        return [self.analyze(design, parameter, v) for v in values]


