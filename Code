"""
Module 06 – SimuVision
Intelligent Simulation Analyzer: automatically interprets simulation
results (I-V data), extracts key metrics, and flags anomalies.

Analyzes:
  - I-V characteristics (transfer & output)
  - Vth extraction (constant-current method)
  - Ion / Ioff
  - Subthreshold slope
  - Leakage, power, delay, breakdown
"""

from __future__ import annotations
import math
from dataclasses import dataclass, field
from typing import Optional

from .smart_sample import SamplePoint


@dataclass
class SimulationAnalysis:
    vth_V: Optional[float] = None
    ion_A_um: Optional[float] = None
    ioff_A_um: Optional[float] = None
    ion_ioff_ratio: Optional[float] = None
    ss_mV_dec: Optional[float] = None
    peak_gm: Optional[float] = None           # transconductance A/V
    leakage_floor_A_um: Optional[float] = None
    breakdown_flag: bool = False
    power_static_uW: Optional[float] = None
    interpretation: list[str] = field(default_factory=list)
    warnings: list[str] = field(default_factory=list)

    def to_dict(self) -> dict:
        def _fmt(v):
            if v is None:
                return "N/A"
            if isinstance(v, float) and abs(v) < 1e-2:
                return f"{v:.3e}"
            return round(v, 4) if isinstance(v, float) else v

        return {
            "vth_V": _fmt(self.vth_V),
            "ion_A_um": _fmt(self.ion_A_um),
            "ioff_A_um": _fmt(self.ioff_A_um),
            "ion_ioff_ratio": _fmt(self.ion_ioff_ratio),
            "ss_mV_dec": _fmt(self.ss_mV_dec),
            "peak_gm_A_V": _fmt(self.peak_gm),
            "leakage_floor_A_um": _fmt(self.leakage_floor_A_um),
            "breakdown_detected": self.breakdown_flag,
            "power_static_uW": _fmt(self.power_static_uW),
            "interpretation": self.interpretation,
            "warnings": self.warnings,
        }


class SimuVision:
    """
    Accepts a list of SamplePoints (transfer curve) and an optional
    output curve list, then extracts and interprets metrics.
    """

    _ICC_THRESHOLD = 1e-7  # A/µm – constant-current Vth method

    def analyze_transfer(
        self,
        transfer_curve: list[SamplePoint],
        vdd: float = 1.8,
        width_um: float = 1.0,
    ) -> SimulationAnalysis:
        result = SimulationAnalysis()

        if len(transfer_curve) < 4:
            result.warnings.append("Too few data points for reliable extraction.")
            return result

        # Sort by |VGS|
        curve = sorted(transfer_curve, key=lambda p: abs(p.vgs))
        vgs_arr = [p.vgs for p in curve]
        ids_arr = [max(abs(p.ids), 1e-20) for p in curve]

        # --- Ioff: minimum current in transfer curve -------------------------
        result.ioff_A_um = min(ids_arr)
        result.leakage_floor_A_um = result.ioff_A_um

        # --- Ion: maximum current in transfer curve --------------------------
        result.ion_A_um = max(ids_arr)

        # --- Vth: constant-current method (ICC = _ICC_THRESHOLD) -------------
        for i in range(len(ids_arr) - 1):
            if ids_arr[i] <= self._ICC_THRESHOLD <= ids_arr[i + 1]:
                # linear interpolation
                frac = (self._ICC_THRESHOLD - ids_arr[i]) / (
                    ids_arr[i + 1] - ids_arr[i]
                )
                result.vth_V = vgs_arr[i] + frac * (vgs_arr[i + 1] - vgs_arr[i])
                break

        # --- Subthreshold slope from log(Id) vs VGS --------------------------
        # Find subthreshold region: IDs below ICC * 100
        sub_pts = [(vgs_arr[i], ids_arr[i]) for i in range(len(ids_arr))
                   if ids_arr[i] < self._ICC_THRESHOLD * 100]
        if len(sub_pts) >= 3:
            log_ids = [math.log10(p[1]) for p in sub_pts]
            vgs_sub = [p[0] for p in sub_pts]
            # linear fit slope
            n = len(sub_pts)
            mx = sum(vgs_sub) / n
            my = sum(log_ids) / n
            num = sum((vgs_sub[i] - mx) * (log_ids[i] - my) for i in range(n))
            den = sum((vgs_sub[i] - mx) ** 2 for i in range(n))
            if den != 0:
                slope_dec_V = num / den   # dec/V
                if slope_dec_V != 0:
                    result.ss_mV_dec = abs(1000 / slope_dec_V)

        # --- Peak transconductance -------------------------------------------
        gm_vals = []
        for i in range(1, len(curve)):
            d_ids = abs(ids_arr[i]) - abs(ids_arr[i - 1])
            d_vgs = abs(vgs_arr[i]) - abs(vgs_arr[i - 1])
            if d_vgs > 0:
                gm_vals.append(d_ids / d_vgs)
        result.peak_gm = max(gm_vals) if gm_vals else None

        # --- Ion / Ioff ------------------------------------------------------
        if result.ioff_A_um and result.ioff_A_um > 0:
            result.ion_ioff_ratio = result.ion_A_um / result.ioff_A_um

        # --- Breakdown detection: sudden current spike in output curve -------
        # (simple heuristic: if max IDS > 5× expected saturation)
        if result.ion_A_um > 1e-2:
            result.breakdown_flag = True
            result.warnings.append(
                "Possible breakdown: unusually high drain current detected."
            )

        # --- Static power ----------------------------------------------------
        result.power_static_uW = result.ioff_A_um * width_um * vdd * 1e6

        # --- Interpretation summary ------------------------------------------
        result.interpretation.append(
            f"Vth extracted at ~{result.vth_V:.3f} V (constant-current method)."
            if result.vth_V is not None else "Vth extraction inconclusive."
        )
        if result.ion_ioff_ratio:
            quality = (
                "excellent" if result.ion_ioff_ratio > 1e6
                else "acceptable" if result.ion_ioff_ratio > 1e4
                else "poor"
            )
            result.interpretation.append(
                f"Ion/Ioff ratio {result.ion_ioff_ratio:.1e} — {quality}."
            )
        if result.ss_mV_dec:
            if result.ss_mV_dec < 70:
                result.interpretation.append(
                    f"SS = {result.ss_mV_dec:.1f} mV/dec — near-ideal switching."
                )
            elif result.ss_mV_dec < 100:
                result.interpretation.append(
                    f"SS = {result.ss_mV_dec:.1f} mV/dec — acceptable."
                )
            else:
                result.warnings.append(
                    f"SS = {result.ss_mV_dec:.1f} mV/dec — degraded, check SCE."
                )

        return result

    def analyze_output(
        self,
        output_curve: list[SamplePoint],
    ) -> list[str]:
        """
        Checks output curve for compliance: saturation, linear region,
        negative resistance (anomaly), kink effect.
        """
        observations = []
        if not output_curve:
            return ["No output curve data provided."]

        # Group by VGS
        vgs_groups: dict[float, list[SamplePoint]] = {}
        for pt in output_curve:
            vgs_groups.setdefault(round(pt.vgs, 4), []).append(pt)

        for vgs, pts in sorted(vgs_groups.items()):
            pts_sorted = sorted(pts, key=lambda p: abs(p.vds))
            ids_vals = [abs(p.ids) for p in pts_sorted]
            # Check for negative dIds/dVds (kink / breakdown)
            dips = sum(
                1 for i in range(1, len(ids_vals))
                if ids_vals[i] < ids_vals[i - 1] * 0.95
            )
            if dips > 1:
                observations.append(
                    f"VGS={vgs:.3f}V: Non-monotonic IDS — possible kink effect or breakdown."
                )
            elif max(ids_vals) > 0 and ids_vals[-1] / max(ids_vals) > 0.98:
                observations.append(
                    f"VGS={vgs:.3f}V: Good saturation behaviour observed."
                )
        return observations


