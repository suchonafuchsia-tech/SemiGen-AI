"""
Module 02 – Device Architect
AI Design Assistant: proposes an initial device design (architecture,
materials, dimensions, oxide thickness, doping, bias, initial parameters)
from a DeviceRequirements object.
"""

from __future__ import annotations
from dataclasses import dataclass, field
from typing import Optional

from .intent2device import DeviceRequirements


@dataclass
class DeviceDesign:
    architecture: str = ""          # e.g. "Planar MOSFET", "FinFET"
    channel_type: str = ""          # N / P
    material: str = ""              # e.g. "Si", "SiGe"
    channel_length_nm: float = 0.0
    channel_width_nm: float = 0.0
    oxide_thickness_nm: float = 0.0
    oxide_material: str = "SiO2"
    doping_channel_cm3: float = 0.0
    doping_source_drain_cm3: float = 0.0
    supply_voltage_V: float = 0.0
    vgs_bias_V: float = 0.0
    vds_bias_V: float = 0.0
    vth_target_V: float = 0.0
    notes: list[str] = field(default_factory=list)

    def to_dict(self) -> dict:
        return self.__dict__.copy()


class DeviceArchitect:
    """
    Rule-based design proposer.  Uses a lookup table of device families
    and scales parameters to the requested performance class.
    """

    # Base design templates keyed by (device_type, channel_type)
    _TEMPLATES: dict[tuple[str, str], dict] = {
        ("MOSFET", "N"): dict(
            architecture="Planar NMOSFET",
            material="Si",
            channel_length_nm=180.0,
            channel_width_nm=1000.0,
            oxide_thickness_nm=3.5,
            oxide_material="SiO2",
            doping_channel_cm3=1e17,
            doping_source_drain_cm3=1e20,
            supply_voltage_V=1.8,
            vgs_bias_V=1.8,
            vds_bias_V=1.8,
            vth_target_V=0.5,
        ),
        ("MOSFET", "P"): dict(
            architecture="Planar PMOSFET",
            material="Si",
            channel_length_nm=180.0,
            channel_width_nm=1000.0,
            oxide_thickness_nm=3.5,
            oxide_material="SiO2",
            doping_channel_cm3=1e17,
            doping_source_drain_cm3=1e20,
            supply_voltage_V=1.8,
            vgs_bias_V=-1.8,
            vds_bias_V=-1.8,
            vth_target_V=-0.5,
        ),
        ("FinFET", "N"): dict(
            architecture="N-type FinFET",
            material="Si",
            channel_length_nm=14.0,
            channel_width_nm=7.0,
            oxide_thickness_nm=1.0,
            oxide_material="HfO2",
            doping_channel_cm3=5e16,
            doping_source_drain_cm3=1e20,
            supply_voltage_V=0.8,
            vgs_bias_V=0.8,
            vds_bias_V=0.8,
            vth_target_V=0.3,
        ),
        ("FinFET", "P"): dict(
            architecture="P-type FinFET",
            material="SiGe",
            channel_length_nm=14.0,
            channel_width_nm=7.0,
            oxide_thickness_nm=1.0,
            oxide_material="HfO2",
            doping_channel_cm3=5e16,
            doping_source_drain_cm3=1e20,
            supply_voltage_V=0.8,
            vgs_bias_V=-0.8,
            vds_bias_V=-0.8,
            vth_target_V=-0.3,
        ),
    }

    _DEFAULT_TEMPLATE = ("MOSFET", "N")

    def propose(self, req: DeviceRequirements) -> DeviceDesign:
        key = (req.device_type, req.channel_type)
        template = self._TEMPLATES.get(key, self._TEMPLATES[self._DEFAULT_TEMPLATE])
        design = DeviceDesign(**template)
        design.channel_type = req.channel_type or design.channel_type

        # --- scale for power class ------------------------------------------
        if req.power_class in ("low", "ultra-low"):
            design.supply_voltage_V *= 0.6
            design.vgs_bias_V = design.supply_voltage_V * (
                1 if req.channel_type != "P" else -1
            )
            design.vds_bias_V = design.vgs_bias_V
            design.oxide_thickness_nm = max(1.0, design.oxide_thickness_nm * 0.8)
            design.channel_length_nm = max(10.0, design.channel_length_nm * 0.7)
            design.notes.append("Scaled for low-power operation.")

        if req.power_class == "high":
            design.supply_voltage_V *= 1.5
            design.channel_width_nm *= 4
            design.doping_source_drain_cm3 *= 1.5
            design.notes.append("Scaled for high-power / high-current operation.")

        # --- leakage tuning -------------------------------------------------
        if req.leakage_target in ("low", "ultra-low"):
            design.vth_target_V = abs(design.vth_target_V) * 1.2
            if req.channel_type == "P":
                design.vth_target_V *= -1
            design.doping_channel_cm3 *= 1.5
            design.notes.append(
                "Increased Vth and channel doping to suppress leakage."
            )

        # --- drive current tuning -------------------------------------------
        if req.drive_current == "high":
            design.channel_width_nm *= 2
            design.channel_length_nm = max(10.0, design.channel_length_nm * 0.85)
            design.notes.append("Widened channel and shortened length for high Ion.")

        # --- override Vth if explicitly specified ---------------------------
        if req.threshold_voltage is not None:
            design.vth_target_V = req.threshold_voltage
            design.notes.append(
                f"Vth overridden by user specification: {req.threshold_voltage} V."
            )

        # --- breakdown voltage hint -----------------------------------------
        if req.breakdown_voltage is not None:
            design.notes.append(
                f"Target breakdown voltage: {req.breakdown_voltage} V – "
                "consider lightly-doped drain (LDD) extension or RESURF technique."
            )

        return design


