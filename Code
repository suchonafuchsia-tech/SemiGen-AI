"""
Module 01 – Intent2Device
Requirement Interpreter: converts natural-language device descriptions
into structured engineering requirements.
"""

from __future__ import annotations
import re
from dataclasses import dataclass, field
from typing import Optional


@dataclass
class DeviceRequirements:
    device_type: str = ""
    power_class: str = ""          # low / medium / high
    drive_current: str = ""        # high / medium / low
    leakage_target: str = ""       # low / ultra-low / standard
    breakdown_voltage: Optional[float] = None  # V
    threshold_voltage: Optional[float] = None  # V
    channel_type: str = ""         # N / P
    application: str = ""
    notes: list[str] = field(default_factory=list)

    def to_dict(self) -> dict:
        return {
            "device_type": self.device_type,
            "channel_type": self.channel_type,
            "power_class": self.power_class,
            "drive_current": self.drive_current,
            "leakage_target": self.leakage_target,
            "breakdown_voltage_V": self.breakdown_voltage,
            "threshold_voltage_V": self.threshold_voltage,
            "application": self.application,
            "notes": self.notes,
        }


class Intent2Device:
    """
    Parses a free-form engineer description and returns a
    DeviceRequirements object with extracted engineering parameters.
    """

    # --- keyword maps -------------------------------------------------------
    _DEVICE_KEYWORDS = {
        "nmos": ("MOSFET", "N"),
        "nfet": ("MOSFET", "N"),
        "pmos": ("MOSFET", "P"),
        "pfet": ("MOSFET", "P"),
        "finfet": ("FinFET", "N"),
        "p-finfet": ("FinFET", "P"),
        "n-finfet": ("FinFET", "N"),
        "bjt": ("BJT", "N"),
        "igbt": ("IGBT", "N"),
        "jfet": ("JFET", "N"),
    }

    _POWER_KEYWORDS = {
        "low-power": "low", "low power": "low",
        "ultra-low power": "ultra-low",
        "high-power": "high", "high power": "high",
        "medium power": "medium",
    }

    _LEAKAGE_KEYWORDS = {
        "low leakage": "low", "low-leakage": "low",
        "ultra-low leakage": "ultra-low",
        "minimal leakage": "low",
    }

    _DRIVE_KEYWORDS = {
        "high drive current": "high", "high current": "high",
        "large drive": "high",
        "low drive": "low", "low current": "low",
    }

    def parse(self, description: str) -> DeviceRequirements:
        req = DeviceRequirements()
        text = description.lower()

        # Device type + channel
        for keyword, (dev, ch) in self._DEVICE_KEYWORDS.items():
            if keyword in text:
                req.device_type = dev
                req.channel_type = ch
                break

        # Power class
        for kw, val in self._POWER_KEYWORDS.items():
            if kw in text:
                req.power_class = val
                break

        # Leakage
        for kw, val in self._LEAKAGE_KEYWORDS.items():
            if kw in text:
                req.leakage_target = val
                break

        # Drive current
        for kw, val in self._DRIVE_KEYWORDS.items():
            if kw in text:
                req.drive_current = val
                break

        # Numeric voltage extraction  e.g. "5V breakdown", "Vth = 0.4V"
        bv_match = re.search(r'(\d+(?:\.\d+)?)\s*v\s*breakdown', text)
        if bv_match:
            req.breakdown_voltage = float(bv_match.group(1))

        vth_match = re.search(r'v[_\s]?t[hn]\s*[=~]\s*(\d+(?:\.\d+)?)\s*v', text)
        if vth_match:
            req.threshold_voltage = float(vth_match.group(1))

        # Application hints
        if any(w in text for w in ["iot", "sensor", "wearable", "implant"]):
            req.application = "IoT/low-power"
        elif any(w in text for w in ["rf", "amplifier", "wireless"]):
            req.application = "RF/analog"
        elif any(w in text for w in ["power supply", "motor", "converter"]):
            req.application = "power electronics"
        elif any(w in text for w in ["logic", "cpu", "memory", "soc"]):
            req.application = "digital logic"

        req.notes.append(f"Source description: \"{description}\"")
        return req


