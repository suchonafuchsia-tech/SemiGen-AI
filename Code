"""
Module 07 – ErrorRadar
Error & Anomaly Detection: identifies abnormal, inconsistent, or
unexpected simulation behaviour.

Detects:
  - Unexpected curves
  - Parameter inconsistencies
  - Deviations from expected behaviour
  - Constraint violations
  - Simulation anomalies

Reports: what changed → where the deviation occurred →
         possible cause → expected physical effect
"""

from __future__ import annotations
from dataclasses import dataclass, field
from typing import Optional

from .smart_sample import DeviceCharacteristics, SamplePoint
from .simu_vision import SimulationAnalysis


@dataclass
class Anomaly:
    severity: str                        # "critical" | "warning" | "info"
    location: str                        # e.g. "transfer curve", "Vth"
    what_changed: str
    possible_cause: str
    expected_physical_effect: str

    def to_dict(self) -> dict:
        return {
            "severity": self.severity,
            "location": self.location,
            "what_changed": self.what_changed,
            "possible_cause": self.possible_cause,
            "expected_physical_effect": self.expected_physical_effect,
        }


@dataclass
class ErrorReport:
    anomalies: list[Anomaly] = field(default_factory=list)
    is_clean: bool = True

    def add(self, anomaly: Anomaly):
        self.anomalies.append(anomaly)
        self.is_clean = False

    def to_dict(self) -> dict:
        return {
            "is_clean": self.is_clean,
            "anomaly_count": len(self.anomalies),
            "anomalies": [a.to_dict() for a in self.anomalies],
        }


# ---------------------------------------------------------------------------
# Thresholds
# ---------------------------------------------------------------------------
_THRESHOLDS = {
    "min_ion_ioff": 1e3,       # minimum acceptable Ion/Ioff
    "max_ss_mV_dec": 200.0,    # SS above this suggests severe SCE or bad data
    "max_leakage_A_um": 1e-6,  # absolute leakage ceiling
    "max_vth_drift_V": 0.15,   # Vth shift vs design target (V)
    "min_gm_A_V": 1e-6,        # transconductance floor
    "max_negative_dids": 2,    # allowed non-monotonic points before kink flag
}


class ErrorRadar:
    """
    Cross-checks simulation analysis against design targets and
    physics rules to raise structured anomaly reports.
    """

    def check(
        self,
        analysis: SimulationAnalysis,
        expected: Optional[DeviceCharacteristics] = None,
        vth_target: Optional[float] = None,
        max_leakage: Optional[float] = None,
    ) -> ErrorReport:
        report = ErrorReport()

        # --- 1. Ion/Ioff check -----------------------------------------------
        if analysis.ion_ioff_ratio is not None:
            if analysis.ion_ioff_ratio < _THRESHOLDS["min_ion_ioff"]:
                report.add(Anomaly(
                    severity="critical",
                    location="Ion/Ioff ratio",
                    what_changed=f"Ion/Ioff = {analysis.ion_ioff_ratio:.1e}",
                    possible_cause=(
                        "Excessive leakage, too-short channel, or too-low Vth"
                    ),
                    expected_physical_effect=(
                        "Device cannot distinguish on/off states; high standby power"
                    ),
                ))

        # --- 2. Subthreshold slope -------------------------------------------
        if analysis.ss_mV_dec is not None:
            if analysis.ss_mV_dec > _THRESHOLDS["max_ss_mV_dec"]:
                report.add(Anomaly(
                    severity="critical",
                    location="Subthreshold slope",
                    what_changed=f"SS = {analysis.ss_mV_dec:.1f} mV/dec",
                    possible_cause=(
                        "Severe short-channel effects, high interface trap density, "
                        "or numerical simulation error"
                    ),
                    expected_physical_effect=(
                        "Very gradual turn-on, high switching power, poor noise margin"
                    ),
                ))
            elif analysis.ss_mV_dec > 100:
                report.add(Anomaly(
                    severity="warning",
                    location="Subthreshold slope",
                    what_changed=f"SS = {analysis.ss_mV_dec:.1f} mV/dec",
                    possible_cause="Moderate short-channel effects or body-bias mismatch",
                    expected_physical_effect="Slightly degraded switching efficiency",
                ))

        # --- 3. Leakage ceiling ----------------------------------------------
        ceiling = max_leakage or _THRESHOLDS["max_leakage_A_um"]
        if analysis.ioff_A_um is not None and analysis.ioff_A_um > ceiling:
            report.add(Anomaly(
                severity="critical",
                location="Off-state leakage (Ioff)",
                what_changed=f"Ioff = {analysis.ioff_A_um:.2e} A/µm",
                possible_cause=(
                    "Channel too short, Vth too low, or high sub-surface leakage path"
                ),
                expected_physical_effect=(
                    "High standby power consumption; battery life degradation"
                ),
            ))

        # --- 4. Vth drift vs design target -----------------------------------
        if vth_target is not None and analysis.vth_V is not None:
            drift = abs(analysis.vth_V - vth_target)
            if drift > _THRESHOLDS["max_vth_drift_V"]:
                report.add(Anomaly(
                    severity="warning",
                    location="Threshold voltage (Vth)",
                    what_changed=(
                        f"Extracted Vth = {analysis.vth_V:.3f} V, "
                        f"target = {vth_target:.3f} V (Δ = {drift:.3f} V)"
                    ),
                    possible_cause=(
                        "Work-function mismatch, doping gradient, oxide charge, "
                        "or process variation"
                    ),
                    expected_physical_effect=(
                        "Circuit logic levels shifted; may cause functional failures"
                    ),
                ))

        # --- 5. Peak gm floor ------------------------------------------------
        if analysis.peak_gm is not None:
            if analysis.peak_gm < _THRESHOLDS["min_gm_A_V"]:
                report.add(Anomaly(
                    severity="warning",
                    location="Peak transconductance (gm)",
                    what_changed=f"gm_peak = {analysis.peak_gm:.2e} A/V",
                    possible_cause=(
                        "Very low mobility, thick oxide, or near-pinch-off operation"
                    ),
                    expected_physical_effect=(
                        "Weak amplification capability; poor frequency response"
                    ),
                ))

        # --- 6. Breakdown flag -----------------------------------------------
        if analysis.breakdown_flag:
            report.add(Anomaly(
                severity="critical",
                location="Breakdown region",
                what_changed="Current spike detected at high VDS",
                possible_cause=(
                    "Avalanche breakdown, GIDL, or punch-through"
                ),
                expected_physical_effect="Device damage; unreliable operation at high bias",
            ))

        # --- 7. Compare against expected characteristics if provided ---------
        if expected is not None:
            if analysis.ion_A_um and expected.ion_A_um:
                ion_dev = abs(analysis.ion_A_um - expected.ion_A_um) / expected.ion_A_um
                if ion_dev > 0.3:
                    report.add(Anomaly(
                        severity="warning",
                        location="On-current (Ion)",
                        what_changed=(
                            f"Simulated Ion = {analysis.ion_A_um:.2e} A/µm, "
                            f"expected = {expected.ion_A_um:.2e} A/µm "
                            f"({ion_dev*100:.0f}% deviation)"
                        ),
                        possible_cause=(
                            "Mobility model mismatch, unexpected velocity saturation, "
                            "or parameter extraction error"
                        ),
                        expected_physical_effect=(
                            "Drive strength different from design intent"
                        ),
                    ))

        return report

    def check_parameter_consistency(
        self,
        channel_length_nm: float,
        oxide_thickness_nm: float,
        doping_channel_cm3: float,
        supply_voltage_V: float,
        vth_target_V: float,
    ) -> ErrorReport:
        """
        Checks whether the combination of design parameters is
        physically self-consistent before simulation.
        """
        report = ErrorReport()

        # Oxide thickness vs channel length scaling rule
        tox_min_rule = channel_length_nm / 50
        if oxide_thickness_nm > channel_length_nm / 10:
            report.add(Anomaly(
                severity="warning",
                location="Oxide thickness / channel length ratio",
                what_changed=(
                    f"tox = {oxide_thickness_nm} nm, L = {channel_length_nm} nm"
                ),
                possible_cause=(
                    "Oxide is too thick relative to channel length (scalability rule)"
                ),
                expected_physical_effect=(
                    "Poor gate control, high Vth, degraded short-channel performance"
                ),
            ))

        # VDD vs Vth margin
        if abs(supply_voltage_V) < abs(vth_target_V) * 1.3:
            report.add(Anomaly(
                severity="critical",
                location="Supply voltage margin",
                what_changed=(
                    f"VDD = {supply_voltage_V} V, Vth = {vth_target_V} V"
                ),
                possible_cause="Supply voltage too close to threshold voltage",
                expected_physical_effect=(
                    "Device may not fully switch on; severe Ion degradation"
                ),
            ))

        # Doping sanity
        if doping_channel_cm3 < 1e14 or doping_channel_cm3 > 1e19:
            report.add(Anomaly(
                severity="warning",
                location="Channel doping",
                what_changed=f"Na = {doping_channel_cm3:.2e} cm⁻³",
                possible_cause="Channel doping outside physically realistic range",
                expected_physical_effect=(
                    "Simulation may produce non-physical results"
                ),
            ))

        return report


