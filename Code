"""
Module 04 – SmartSample
Sample-to-Output Intelligence: generates expected I-V characteristics,
Vth, Ion/Ioff, leakage, power, and performance curves from device
parameters, learning the underlying physics relationships even with
a sparse sample set.
"""

from __future__ import annotations
import math
from dataclasses import dataclass, field
from typing import Optional

from .device_architect import DeviceDesign


@dataclass
class SamplePoint:
    vgs: float
    vds: float
    ids: float  # drain current (A/µm)


@dataclass
class DeviceCharacteristics:
    vth_V: float = 0.0
    ion_A_um: float = 0.0        # on-state current per micron
    ioff_A_um: float = 0.0       # off-state leakage per micron
    ion_ioff_ratio: float = 0.0
    ss_mV_dec: float = 0.0       # subthreshold slope mV/dec
    power_dynamic_uW: float = 0.0
    power_static_uW: float = 0.0
    iv_transfer: list[SamplePoint] = field(default_factory=list)  # VGS sweep @ fixed VDS
    iv_output: list[SamplePoint] = field(default_factory=list)    # VDS sweep @ fixed VGS
    predicted_trends: list[str] = field(default_factory=list)

    def to_dict(self) -> dict:
        return {
            "vth_V": round(self.vth_V, 4),
            "ion_A_um": f"{self.ion_A_um:.3e}",
            "ioff_A_um": f"{self.ioff_A_um:.3e}",
            "ion_ioff_ratio": f"{self.ion_ioff_ratio:.2e}",
            "ss_mV_dec": round(self.ss_mV_dec, 1),
            "power_dynamic_uW": round(self.power_dynamic_uW, 4),
            "power_static_uW": round(self.power_static_uW, 6),
            "iv_transfer_points": len(self.iv_transfer),
            "iv_output_points": len(self.iv_output),
            "predicted_trends": self.predicted_trends,
        }


class SmartSample:
    """
    Physics-informed analytical model that generates expected device
    characteristics from a DeviceDesign.

    Uses long-channel MOSFET equations (level-1 SPICE equivalent)
    corrected with short-channel heuristics for L < 100 nm.
    """

    _KT_q = 0.02585          # kT/q at 300 K  (V)
    _mu_n = 450.0             # electron mobility cm²/V·s
    _mu_p = 160.0             # hole mobility cm²/V·s
    _eps_SiO2 = 3.9 * 8.854e-12   # F/m
    _eps_HfO2 = 22.0 * 8.854e-12
    _q = 1.6e-19
    _ni = 1.45e10             # intrinsic carrier concentration cm⁻³

    def _oxide_capacitance(self, design: DeviceDesign) -> float:
        """Cox in F/cm² """
        tox_cm = design.oxide_thickness_nm * 1e-9 * 100  # nm → cm
        eps = (
            self._eps_HfO2 if "hfo2" in design.oxide_material.lower()
            else self._eps_SiO2
        )
        eps_cm = eps * 1e-2          # F/m → F/cm
        return eps_cm / tox_cm

    def _mobility(self, design: DeviceDesign) -> float:
        """cm²/V·s — degraded slightly for thin oxides"""
        mu0 = self._mu_n if design.channel_type != "P" else self._mu_p
        tox_penalty = max(0.5, 1.0 - 0.01 * (5.0 - design.oxide_thickness_nm))
        return mu0 * tox_penalty

    def _ids_linear(
        self, mu: float, cox: float, wl: float,
        vgs: float, vth: float, vds: float
    ) -> float:
        """Drain current in linear region (A/µm-normalised)"""
        if vgs < vth:
            return 0.0
        vdsat = vgs - vth
        vds_eff = min(vds, vdsat)
        return mu * cox * wl * ((vgs - vth) * vds_eff - 0.5 * vds_eff ** 2)

    def _ids_saturation(
        self, mu: float, cox: float, wl: float,
        vgs: float, vth: float
    ) -> float:
        """Drain current in saturation (A/µm-normalised)"""
        if vgs < vth:
            return 0.0
        return 0.5 * mu * cox * wl * (vgs - vth) ** 2

    def _subthreshold_current(
        self, vgs: float, vth: float, ss_V_dec: float, ioff: float
    ) -> float:
        """Subthreshold leakage"""
        return ioff * 10 ** ((vgs - vth) / ss_V_dec)

    def generate(
        self,
        design: DeviceDesign,
        n_transfer_points: int = 20,
        n_output_curves: int = 5,
    ) -> DeviceCharacteristics:
        char = DeviceCharacteristics()

        cox = self._oxide_capacitance(design)
        mu = self._mobility(design)
        L_um = design.channel_length_nm * 1e-3   # nm → µm
        W_um = design.channel_width_nm * 1e-3
        wl = W_um / L_um

        vdd = abs(design.supply_voltage_V)
        sign = 1 if design.channel_type != "P" else -1
        vth = design.vth_target_V

        # --- subthreshold slope (ideal 60 mV/dec; degraded for short L) -----
        n_body = 1.0 + max(0, (100 - design.channel_length_nm) / 200)
        ss_V_dec = self._KT_q * math.log(10) * n_body
        char.ss_mV_dec = ss_V_dec * 1000

        # --- Ioff at VGS = 0 -------------------------------------------------
        ioff_A = 1e-12 * (1.0 + max(0, 100 - design.channel_length_nm) * 5e-3)
        char.ioff_A_um = ioff_A / W_um

        # --- Ion at VGS = VDS = VDD ------------------------------------------
        vgs_on = sign * vdd
        vds_on = sign * vdd
        if design.channel_type == "P":
            ion = abs(self._ids_saturation(mu, cox, wl, abs(vgs_on), abs(vth)))
        else:
            ion = self._ids_saturation(mu, cox, wl, vgs_on, vth)
        char.ion_A_um = max(ion, char.ioff_A_um * 10)
        char.vth_V = vth
        char.ion_ioff_ratio = char.ion_A_um / char.ioff_A_um

        # --- Transfer curve (VGS sweep, VDS = VDD/2) -------------------------
        vds_fixed = sign * vdd * 0.5
        vgs_vals = [
            sign * (i / (n_transfer_points - 1)) * vdd * 1.2
            for i in range(n_transfer_points)
        ]
        for vgs in vgs_vals:
            if abs(vgs) < abs(vth):
                ids = self._subthreshold_current(
                    abs(vgs), abs(vth), ss_V_dec, char.ioff_A_um * W_um
                )
            else:
                ids = self._ids_saturation(mu, cox, wl, abs(vgs), abs(vth))
            char.iv_transfer.append(
                SamplePoint(vgs=round(vgs, 4), vds=round(vds_fixed, 4), ids=round(ids, 6))
            )

        # --- Output curves (VDS sweep for several VGS values) ----------------
        for i in range(1, n_output_curves + 1):
            vgs_val = sign * (i / n_output_curves) * vdd
            n_vds = 15
            for j in range(n_vds):
                vds_val = sign * (j / (n_vds - 1)) * vdd
                ids = self._ids_linear(
                    mu, cox, wl, abs(vgs_val), abs(vth), abs(vds_val)
                )
                char.iv_output.append(
                    SamplePoint(
                        vgs=round(vgs_val, 4),
                        vds=round(vds_val, 4),
                        ids=round(ids, 6),
                    )
                )

        # --- Power estimates -------------------------------------------------
        freq = 1e9  # assume 1 GHz toggle
        char.power_dynamic_uW = (
            0.5 * cox * W_um * 1e-4 * L_um * 1e-4 * vdd ** 2 * freq * 1e6
        )  # µW
        char.power_static_uW = char.ioff_A_um * W_um * vdd * 1e6  # µW

        # --- Trend predictions -----------------------------------------------
        char.predicted_trends.append(
            f"Expected Ion/Ioff ratio: ~{char.ion_ioff_ratio:.1e}"
        )
        if design.channel_length_nm < 50:
            char.predicted_trends.append(
                "Short-channel effects (SCE) expected — DIBL and Vth roll-off likely."
            )
        if design.oxide_thickness_nm < 2:
            char.predicted_trends.append(
                "Gate oxide tunnelling current may be significant (tox < 2 nm)."
            )
        if char.ss_mV_dec > 80:
            char.predicted_trends.append(
                "Subthreshold slope degraded by short-channel effects."
            )

        return char


